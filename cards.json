const allCards = [
          // Section 1: Love & Romantic (80 cards)
          { id: 1, category: "Love & Romantic", title: "Whisper Your Admiration", description: "Take a moment to connect. Whisper three things you find romantic about your partner right now—notice their smile, their kindness, their energy. Let them feel truly seen.", timer: 180, intensity: 1, section: 1 },
          { id: 2, category: "Love & Romantic", title: "Eye Contact Meditation", description: "Hold eye contact for 60 seconds while gently holding hands. No words needed. Just breathe together and let your eyes do the talking. This simple act deepens connection like nothing else.", timer: 60, intensity: 1, section: 1 },
          { id: 3, category: "Love & Romantic", title: "Memory Lane Moment", description: "Share one happy memory of the two of you and explain why it still matters. Relive the warmth of that moment together right now.", timer: 300, intensity: 1, section: 1 },
          { id: 4, category: "Love & Romantic", title: "First Attraction Story", description: "Tell them the very first thing that attracted you to them. What made you pause? What made your heart skip? Remind them of the magic that started it all.", timer: 240, intensity: 1, section: 1 },
          { id: 5, category: "Love & Romantic", title: "Slow Dance Together", description: "Slow-dance together for one full song—music optional. Hold each other close, move slowly, and let the rhythm of your bodies sync. This is romance in its purest form.", timer: 300, intensity: 1, section: 1 },
          { id: 6, category: "Love & Romantic", title: "Handwritten Love Note", description: "Write a short romantic note and hand it to them. Whether it's three words or three paragraphs, let pen and paper carry your feelings. They'll treasure this.", timer: 300, intensity: 1, section: 1 },
          { id: 7, category: "Love & Romantic", title: "Appreciation Circle", description: "Sit facing each other and take turns saying one appreciation about the other. Keep going back and forth—let them hear all the ways they matter to you.", timer: 300, intensity: 1, section: 1 },
          { id: 8, category: "Love & Romantic", title: "Hand Walk & Future Dreams", description: "Hold hands and walk slowly around the room while sharing a dream for the future. Picture it together. Walk toward it. This is how you build a life together.", timer: 360, intensity: 1, section: 1 },
          { id: 9, category: "Love & Romantic", title: "Breath Sync Connection", description: "Rest your forehead against theirs and breathe in sync for one minute. Feel their heartbeat. Feel their breath. This is intimacy without touch—pure presence.", timer: 60, intensity: 1, section: 1 },
          { id: 10, category: "Love & Romantic", title: "Gentle Face Tracing", description: "Trace the outline of their face lightly with one fingertip—across their cheekbones, along their jawline, down to their chin. Memorize them. Love them with your touch.", timer: 180, intensity: 1, section: 1 },
          { id: 11, category: "Love & Romantic", title: "Sweet Feeding Moment", description: "Feed each other something sweet while maintaining soft eye contact. Chocolate, fruit, honey—whatever it is, make this about connection and sensuality.", timer: 240, intensity: 1, section: 1 },
          { id: 12, category: "Love & Romantic", title: "Share a Gentle Fantasy", description: "Share one light, non-sexual fantasy about a perfect day together. Picnicking? Traveling? Staying in bed all morning? Paint the picture together.", timer: 300, intensity: 1, section: 1 },
          { id: 13, category: "Love & Romantic", title: "Romantic Would You Rather", description: "Play a simple 'would you rather' game with only romantic options. Would you rather dance in the rain or under the stars? These questions matter—they reveal desires.", timer: 300, intensity: 1, section: 1 },
          { id: 14, category: "Love & Romantic", title: "Three Admired Qualities", description: "Tell them three qualities you admire in them as a partner. Their patience? Their strength? Their gentleness? Be specific. Let them know exactly what makes them worthy.", timer: 240, intensity: 1, section: 1 },
          { id: 15, category: "Love & Romantic", title: "Shoulder Lean Silence", description: "Sit side-by-side and lean shoulders together in silence for two minutes. Sometimes the deepest connection needs no words. Just be present.", timer: 120, intensity: 1, section: 1 },
          { id: 16, category: "Love & Romantic", title: "Favorite Feature Praise", description: "Describe your favorite physical feature of theirs without touching. Is it their eyes? Their hands? Their smile? Tell them why it captivates you.", timer: 180, intensity: 1, section: 1 },
          { id: 17, category: "Love & Romantic", title: "Positive Affirmation Squeezes", description: "Give a gentle hand squeeze every time you say something positive about them or your relationship. Watch how many squeezes of love you can give.", timer: 300, intensity: 1, section: 1 },
          { id: 18, category: "Love & Romantic", title: "First Meeting Role-Play", description: "Recreate your first meeting in a short, light role-play—talking only. Do you remember your first words? How you felt? Step back into that magic.", timer: 300, intensity: 1, section: 1 },
          { id: 19, category: "Love & Romantic", title: "Gratitude Statement", description: "Share one thing you're grateful for about your relationship today. Maybe it's their laugh. Maybe it's how they make you feel safe. Say it out loud.", timer: 180, intensity: 1, section: 1 },
          { id: 20, category: "Love & Romantic", title: "Photo Memory Review", description: "Look at old photos together and comment on happy moments. Point out the joy in their eyes, the way you held each other. Celebrate your history.", timer: 300, intensity: 1, section: 1 },
          { id: 21, category: "Love & Romantic", title: "Romantic Poetry Whisper", description: "Whisper a short poem or made-up romantic line into their ear. It doesn't have to be perfect—authenticity is sexier than poetry.", timer: 120, intensity: 1, section: 1 },
          { id: 22, category: "Love & Romantic", title: "Two Truths and a Wish", description: "Play 'two truths and a wish' focused only on sweet or future wishes. Share your dreams. Listen to theirs. Build your life together in conversation.", timer: 300, intensity: 1, section: 1 },
          { id: 23, category: "Love & Romantic", title: "Why I Feel Safe With You", description: "Hold both their hands and tell them why you feel safe with them. Is it their strength? Their gentleness? Their consistency? Make them know they're your anchor.", timer: 180, intensity: 1, section: 1 },
          { id: 24, category: "Love & Romantic", title: "Slow Waist Dance", description: "Dance slowly in place with hands on each other's waist—clothes on. Sway together. Feel the rhythm of your bodies aligned. This is how love moves.", timer: 240, intensity: 1, section: 1 },
          { id: 25, category: "Love & Romantic", title: "Best Compliment Received", description: "Share the best compliment you've ever received from them. How did it make you feel? Why did it matter? Compliments are gifts—give them weight.", timer: 180, intensity: 1, section: 1 },
          { id: 26, category: "Love & Romantic", title: "Back-to-Back Feelings", description: "Sit back-to-back and describe what you're feeling in the moment. No eye contact needed—just honesty. Sometimes vulnerability flows easier this way.", timer: 240, intensity: 1, section: 1 },
          { id: 27, category: "Love & Romantic", title: "Forearm Touch Statement", description: "Give a soft, brief touch to their forearm while making a sincere statement about them or your love. Let touch punctuate your words with tenderness.", timer: 180, intensity: 1, section: 1 },
          { id: 28, category: "Love & Romantic", title: "Plan Future Date Aloud", description: "Plan a future date out loud in as much detail as possible. Where? When? What will you wear? What will you say? Make it real before it happens.", timer: 300, intensity: 1, section: 1 },
          { id: 29, category: "Love & Romantic", title: "Better Person Through Love", description: "Tell them one way they've made you a better person. Have they softened you? Challenged you? Shown you what love really is? Let them know their impact.", timer: 240, intensity: 1, section: 1 },
          { id: 30, category: "Love & Romantic", title: "Thumb Circle Eye Contact", description: "Maintain soft eye contact while slowly circling your thumbs on their hands. This small gesture carries big meaning—presence, affection, attention.", timer: 120, intensity: 1, section: 1 },
          { id: 31, category: "Love & Romantic", title: "Childhood Love Story", description: "Share a childhood memory that shaped how you love. What did you learn about love early on? How has it influenced how you love them?", timer: 300, intensity: 1, section: 1 },
          { id: 32, category: "Love & Romantic", title: "Staring Contest Smile", description: "Play a quiet staring contest and smile when you break. Let this be playful, not serious. See who lasts longer. Laugh when you both crack.", timer: 180, intensity: 1, section: 1 },
          { id: 33, category: "Love & Romantic", title: "Ideal Cozy Evening", description: "Describe your ideal cozy evening together without any physical escalation. Fireplace? Books? Wine? Paint the picture of contentment together.", timer: 240, intensity: 1, section: 1 },
          { id: 34, category: "Love & Romantic", title: "Gentle Shoulder Lean", description: "Offer a gentle shoulder lean while listening to them speak. Be their anchor. Be their support. Sometimes the best love is just being there.", timer: 180, intensity: 1, section: 1 },
          { id: 35, category: "Love & Romantic", title: "Love Words on Palm", description: "Write three words that describe your love on their palm with your finger. Let them guess what you're writing. Make it intimate and slow.", timer: 120, intensity: 1, section: 1 },
          { id: 36, category: "Love & Romantic", title: "I Feel Closest When...", description: "Take turns completing the sentence: 'I feel closest to you when...' Listen deeply. Learn their language of love. Repeat it back to them.", timer: 300, intensity: 1, section: 1 },
          { id: 37, category: "Love & Romantic", title: "Hand Hold Meditation", description: "Hold hands under a blanket or across a table for three full minutes. No talking. No looking away. Just hands, warmth, and connection.", timer: 180, intensity: 1, section: 1 },
          { id: 38, category: "Love & Romantic", title: "Daily Habit Love", description: "Share one small daily habit of theirs that you secretly love. Maybe it's how they make coffee. Maybe it's their morning stretch. Tell them.", timer: 180, intensity: 1, section: 1 },
          { id: 39, category: "Love & Romantic", title: "Hand Touch Song List", description: "Softly touch the back of their hand while listing favorite shared songs. Each song is a memory. Each touch is a kiss of gratitude.", timer: 240, intensity: 1, section: 1 },
          { id: 40, category: "Love & Romantic", title: "Close Hand Hold Smile", description: "End this section by simply sitting close, holding hands, and smiling at each other. No performance. Just two people in love, right here, right now.", timer: 120, intensity: 1, section: 1 },
          { id: 41, category: "Love & Romantic", title: "Loving Gaze Exchange", description: "Look at each other with nothing but love in your eyes. Don't analyze or think—just feel. Let your gaze say everything words cannot.", timer: 120, intensity: 1, section: 1 },
          { id: 42, category: "Love & Romantic", title: "Partner Appreciation List", description: "Make a mental list of 10 things you love about them and share them one by one. Watch their face light up with each one. This matters.", timer: 300, intensity: 1, section: 1 },
          { id: 43, category: "Love & Romantic", title: "Soft Neck Trace", description: "Gently trace along their neck with your fingertips while telling them something you love about them. Let touch and words blend into affection.", timer: 180, intensity: 1, section: 1 },
          { id: 44, category: "Love & Romantic", title: "Dream Conversation", description: "Share your biggest dreams with each other. Career, travel, family—whatever matters to you. Then ask how you can support each other reaching them.", timer: 300, intensity: 1, section: 1 },
          { id: 45, category: "Love & Romantic", title: "Foreheads Together Close", description: "Press your foreheads together, close your eyes, and just be. Breathe. Feel their presence. This is meditation. This is love.", timer: 120, intensity: 1, section: 1 },
          { id: 46, category: "Love & Romantic", title: "Voice Appreciation", description: "Tell them how much you love their voice. The way they laugh? The way they say your name? The tenderness in how they speak to you?", timer: 180, intensity: 1, section: 1 },
          { id: 47, category: "Love & Romantic", title: "Hand Kiss Series", description: "Kiss each of their fingers, one by one. Slow. Intentional. Let each kiss say: 'I choose you. I cherish you. I see you.'", timer: 180, intensity: 1, section: 1 },
          { id: 48, category: "Love & Romantic", title: "Love Language Discovery", description: "Discuss your love languages. Do they prefer words? Touch? Acts of service? Gifts? Quality time? Understanding this deepens your connection forever.", timer: 300, intensity: 1, section: 1 },
          { id: 49, category: "Love & Romantic", title: "Shoulder Caress", description: "Massage their shoulders gently while they relax. Let your hands express gratitude for carrying life alongside you. Care for them like this.", timer: 300, intensity: 1, section: 1 },
          { id: 50, category: "Love & Romantic", title: "Gratitude Ritual", description: "Stand facing each other and take turns saying one thing you're grateful for about being in this relationship. Make it heartfelt. Make it real.", timer: 240, intensity: 1, section: 1 },
          { id: 51, category: "Love & Romantic", title: "Gentle Temple Kiss", description: "Kiss their temple softly while wrapping your arms around them from behind. This simple gesture says: 'I'm here. You're safe. You're loved.'", timer: 120, intensity: 1, section: 1 },
          { id: 52, category: "Love & Romantic", title: "Future Vision Sharing", description: "Describe your future together in vivid detail. Where do you live? What does your life look like? Make it real by speaking it into existence together.", timer: 300, intensity: 1, section: 1 },
          { id: 53, category: "Love & Romantic", title: "Chest-to-Chest Hold", description: "Hold each other close, chest to chest, and feel your heartbeats synchronize. This is where souls touch. This is where love lives.", timer: 180, intensity: 1, section: 1 },
          { id: 54, category: "Love & Romantic", title: "Love Letter Exchange", description: "Write each other love letters and read them aloud. Pour your heart onto paper. Hear their words. Let this become a keepsake of your love.", timer: 300, intensity: 1, section: 1 },
          { id: 55, category: "Love & Romantic", title: "Eye Gaze Affirmation", description: "Look into their eyes and tell them three affirmations. 'You are worthy.' 'You are loved.' 'You are mine.' Watch them believe it.", timer: 180, intensity: 1, section: 1 },
          { id: 56, category: "Love & Romantic", title: "Soft Hair Caress", description: "Run your fingers gently through their hair while telling them how beautiful they are. This intimate gesture soothes and connects.", timer: 180, intensity: 1, section: 1 },
          { id: 57, category: "Love & Romantic", title: "Vulnerable Sharing", description: "Share something vulnerable about yourself—a fear, a dream, an insecurity. Let them know the real you. This is where true intimacy begins.", timer: 300, intensity: 1, section: 1 },
          { id: 58, category: "Love & Romantic", title: "Partner Strengths Affirmation", description: "Tell them five strengths you see in them. Not just physical—their character, their spirit, their resilience. Make them feel invincible.", timer: 240, intensity: 1, section: 1 },
          { id: 59, category: "Love & Romantic", title: "Synchronized Breathing", description: "Sit facing each other and sync your breathing for two minutes. In together. Out together. Feel how close you become in this rhythm.", timer: 120, intensity: 1, section: 1 },
          { id: 60, category: "Love & Romantic", title: "Love Renewal Vow", description: "Say a simple vow to each other renewing your commitment. 'I choose you today and every day.' Let this be your moment of re-devotion.", timer: 180, intensity: 1, section: 1 },
          { id: 61, category: "Love & Romantic", title: "Soft Lip Kiss", description: "Kiss their lips softly—no rush, no passion, just tenderness. Let this be about connection, not intensity. Slow down. Savor them.", timer: 120, intensity: 1, section: 1 },
          { id: 62, category: "Love & Romantic", title: "Couple Playlist Creation", description: "Create a playlist together of songs that define your relationship. Each song is a chapter of your story. Listen to it and remember.", timer: 300, intensity: 1, section: 1 },
          { id: 63, category: "Love & Romantic", title: "Inside Joke Moment", description: "Laugh together about inside jokes only you two share. These moments are sacred. They're proof of your unique connection and history.", timer: 180, intensity: 1, section: 1 },
          { id: 64, category: "Love & Romantic", title: "Skin-to-Skin Cuddle", description: "Cuddle closely with as much skin contact as possible while remaining clothed. Feel their warmth. Feel their heartbeat. This is comfort.", timer: 300, intensity: 1, section: 1 },
          { id: 65, category: "Love & Romantic", title: "Partner Favorite Things", description: "Tell them your favorite things about them—favorite laugh, favorite outfit, favorite way they look at you. Make these small things huge.", timer: 240, intensity: 1, section: 1 },
          { id: 66, category: "Love & Romantic", title: "Hand Heart Over Heart", description: "Place your hand over their heart while they place theirs over yours. Feel each other's heartbeats. This is the pulse of your love.", timer: 120, intensity: 1, section: 1 },
          { id: 67, category: "Love & Romantic", title: "Whispered Sweet Nothings", description: "Whisper sweet words directly into their ear—slowly, intimately. Let them feel your breath and hear your voice like it's meant only for them.", timer: 180, intensity: 1, section: 1 },
          { id: 68, category: "Love & Romantic", title: "Tomorrow's Promise", description: "Make a promise to each other for tomorrow. It can be as simple as 'I'll make you coffee' or as big as 'I'll always choose you.' Mean it.", timer: 180, intensity: 1, section: 1 },
          { id: 69, category: "Love & Romantic", title: "Forever Moment", description: "Just be together. No task, no timer, no expectation. Hold each other. Look at each other. Let this moment become one you'll remember forever.", timer: 180, intensity: 1, section: 1 },
          { id: 70, category: "Love & Romantic", title: "Sensual Wrist Caress", description: "Hold their wrist gently and trace circles with your thumb while looking into their eyes. This tender gesture speaks of care and devotion.", timer: 120, intensity: 1, section: 1 },
          { id: 71, category: "Love & Romantic", title: "Quiet Morning Together", description: "Sit together in silence as the sun rises or sets. No phones. No distractions. Just you, them, and the passage of time together.", timer: 300, intensity: 1, section: 1 },
          { id: 72, category: "Love & Romantic", title: "Sensory Presence", description: "Focus on all five senses with them. Notice their scent. Their warmth. The softness of their skin. Their voice. Their taste when you kiss.", timer: 240, intensity: 1, section: 1 },
          { id: 73, category: "Love & Romantic", title: "Tender Ear Whisper", description: "Whisper 'I love you' into their ear in as many languages as you know. Make it playful. Make it sincere. Make it memorable.", timer: 120, intensity: 1, section: 1 },
          { id: 74, category: "Love & Romantic", title: "Cradle and Rock", description: "Hold them and gently rock back and forth like they're the most precious thing in your world. Sometimes we all need to be cared for like this.", timer: 180, intensity: 1, section: 1 },
          { id: 75, category: "Love & Romantic", title: "Slow Circle Dance", description: "Hold them close and slowly circle around while talking. Let movement and conversation intertwine. This is dancing without music.", timer: 240, intensity: 1, section: 1 },
          { id: 76, category: "Love & Romantic", title: "Cheek-to-Cheek Moment", description: "Press your cheeks together and hold. Feel the warmth. Whisper something tender. This simple closeness says so much.", timer: 120, intensity: 1, section: 1 },
          { id: 77, category: "Love & Romantic", title: "Love Letter Reading", description: "Read a romantic poem or love letter to them. Let words of romance—whether yours or someone else's—wash over you both.", timer: 180, intensity: 1, section: 1 },
          { id: 78, category: "Love & Romantic", title: "Dance in Darkness", description: "Dance together in dim or darkness, relying only on touch and presence. This builds trust and intimacy in a whole new way.", timer: 240, intensity: 1, section: 1 },
          { id: 79, category: "Love & Romantic", title: "Reflection of Love", description: "Tell them how you've changed because of their love. Have you become braver? Kinder? More open? Let them know their love transformed you.", timer: 240, intensity: 1, section: 1 },
          { id: 80, category: "Love & Romantic", title: "Sacred Space Closing", description: "End Section 1 by creating a sacred space together—physically or verbally. This is your sanctuary. You did beautiful work here. Celebrate that.", timer: 180, intensity: 1, section: 1 },
          
          // Section 2: Hug & Kisses (80 cards - abbreviated for space)
          { id: 81, category: "Hug & Kisses", title: "Long Warm Embrace", description: "Give a long, warm full-body hug that lasts at least 60 seconds. Don't rush. Let your bodies settle into each other. This is where safety lives.", timer: 60, intensity: 2, section: 2 },
          { id: 82, category: "Hug & Kisses", title: "Slow Neck Kiss", description: "Kiss the back of their neck slowly for 30 seconds. Feel their skin. Breathe gently. This tender area is surprisingly sensitive—explore it with care.", timer: 30, intensity: 2, section: 2 },
          { id: 83, category: "Hug & Kisses", title: "Forehead to Cheek Trail", description: "Trail light kisses from their forehead down to their cheek. Let each kiss be soft, intentional. You're mapping their face with affection.", timer: 120, intensity: 2, section: 2 },
          { id: 84, category: "Hug & Kisses", title: "Back Hug Shoulder Rest", description: "Hug them from behind and rest your chin on their shoulder. Wrap your arms around their waist. This protective pose shows they're safe with you.", timer: 180, intensity: 2, section: 2 },
          { id: 85, category: "Hug & Kisses", title: "Fingertip Kiss Tour", description: "Give soft kisses to every fingertip on one hand. One by one, gently. Let them feel cherished in the smallest details.", timer: 120, intensity: 2, section: 2 },
          { id: 86, category: "Hug & Kisses", title: "Teasing Almost-Kiss", description: "Tease by almost kissing for a full minute, then finally kiss deeply. Build the anticipation. Watch their breath catch. This is erotic tension at its finest.", timer: 60, intensity: 2, section: 2 },
          { id: 87, category: "Hug & Kisses", title: "Whispered Hug", description: "Hold them tightly while whispering something sweet directly into their ear. Let them feel wanted. Let them feel desired.", timer: 120, intensity: 2, section: 2 },
          { id: 88, category: "Hug & Kisses", title: "Jawline Kiss Journey", description: "Kiss along their jawline slowly from ear to chin. Each kiss is a punctuation mark on the map of their face. Take your time.", timer: 120, intensity: 2, section: 2 },
          { id: 89, category: "Hug & Kisses", title: "Playful Neck Nuzzle", description: "Give a playful nuzzle against their neck while hugging. Breathe them in. Let your nose and lips dance across their skin.", timer: 120, intensity: 2, section: 2 },
          { id: 90, category: "Hug & Kisses", title: "Lap Sit Kiss Exchange", description: "Sit on their lap (clothed) and exchange soft kisses. Feel their arms around you. Feel their strength. This is vulnerable intimacy.", timer: 180, intensity: 2, section: 2 },
          { id: 91, category: "Hug & Kisses", title: "Back Caress Hug", description: "Trace light circles on their back while hugging. Your hands are speaking—gentle, patient, loving messages through touch.", timer: 180, intensity: 2, section: 2 },
          { id: 92, category: "Hug & Kisses", title: "Wrist Kiss Hold", description: "Kiss the inside of their wrist and hold it there. This pulse point throbs with life—respect it with your lips and presence.", timer: 120, intensity: 2, section: 2 },
          { id: 93, category: "Hug & Kisses", title: "Tight Hug Deep Kiss", description: "Hug them tightly, then pull back just enough for a deep kiss. Connect on every level—physically and emotionally.", timer: 180, intensity: 2, section: 2 },
          { id: 94, category: "Hug & Kisses", title: "Lip Bite and Soothe", description: "Lightly bite their lower lip during a kiss, then soothe it immediately with your tongue or lips. Tease and comfort in one motion.", timer: 120, intensity: 2, section: 2 },
          { id: 95, category: "Hug & Kisses", title: "Sway and Kiss", description: "Wrap your arms around them and sway gently while kissing. Let your bodies move together—rhythm, timing, synchronicity.", timer: 180, intensity: 2, section: 2 },
          { id: 96, category: "Hug & Kisses", title: "Eyelid Kiss", description: "Kiss their closed eyelids one at a time. This delicate area deserves reverence. Each kiss says: 'I honor every part of you.'", timer: 120, intensity: 2, section: 2 },
          { id: 97, category: "Hug & Kisses", title: "Playful Face Kiss Series", description: "Give a series of quick, playful kisses all over their face—cheeks, nose, forehead, chin. Make them laugh while making them feel adored.", timer: 120, intensity: 2, section: 2 },
          { id: 98, category: "Hug & Kisses", title: "Face Cradle Deep Kiss", description: "Hold their face gently in both hands while kissing deeply. This is control mixed with tenderness—a powerful combination.", timer: 120, intensity: 2, section: 2 },
          { id: 99, category: "Hug & Kisses", title: "Side Hug Temple Kiss", description: "Hug from the side and kiss their temple repeatedly. This is comfort. This is care. This is love in its simplest form.", timer: 120, intensity: 2, section: 2 },
          { id: 100, category: "Hug & Kisses", title: "Ear Tease Breath", description: "Tease their ear with soft breath and light kisses. Blow gently. Whisper. Kiss. This sensitive area deserves slow exploration.", timer: 120, intensity: 2, section: 2 },
          { id: 101, category: "Hug & Kisses", title: "Standing Full Press Kiss", description: "Press your bodies together in a standing hug and kiss slowly. Feel their full length against yours. This is full-body connection.", timer: 180, intensity: 2, section: 2 },
          { id: 102, category: "Hug & Kisses", title: "Two-Sided Neck Kiss", description: "Kiss down one side of their neck, then the other. Mirror yourself. Make it symmetrical. Make it intentional.", timer: 120, intensity: 2, section: 2 },
          { id: 103, category: "Hug & Kisses", title: "Reassuring Hug Affirmation", description: "Give a firm, reassuring hug while saying something affirming. 'You're strong.' 'You're safe.' 'You're mine.' Let them feel held.", timer: 120, intensity: 2, section: 2 },
          { id: 104, category: "Hug & Kisses", title: "Finger Interlace Pull", description: "Interlock fingers and pull them into a long kiss. Your hands are connected. Your lips are connected. Full integration.", timer: 120, intensity: 2, section: 2 },
          { id: 105, category: "Hug & Kisses", title: "Hair and Neck Nuzzle", description: "Nuzzle their hair or neck while holding them close. Breathe them in. Let your presence be felt through closeness.", timer: 120, intensity: 2, section: 2 },
          { id: 106, category: "Hug & Kisses", title: "Corner Mouth Kiss", description: "Kiss the corner of their mouth, then move fully onto their lips. This teasing buildup makes the full kiss taste even better.", timer: 120, intensity: 2, section: 2 },
          { id: 107, category: "Hug & Kisses", title: "Back Scratch Hug", description: "Hug tightly and run hands slowly up and down their back over clothes. Let them feel cared for. Let them relax into you.", timer: 180, intensity: 2, section: 2 },
          { id: 108, category: "Hug & Kisses", title: "Collarbone Kiss Trail", description: "Give a trail of kisses along their collarbone area—clothes on. This often-neglected area is surprisingly responsive to attention.", timer: 120, intensity: 2, section: 2 },
          { id: 109, category: "Hug & Kisses", title: "Intertwined Legs Kiss", description: "Sit facing each other, legs intertwined, and exchange soft kisses. You're tangled together—physically and emotionally.", timer: 180, intensity: 2, section: 2 },
          { id: 110, category: "Hug & Kisses", title: "Lips Off Tease", description: "Tease by kissing everywhere except the lips for one minute. Build anticipation. Make them want your lips. Then give them what they crave.", timer: 60, intensity: 2, section: 2 },
          { id: 111, category: "Hug & Kisses", title: "Mid-Talk Pull Hug", description: "Pull them into a hug mid-conversation and hold. Sometimes words need to pause for connection. Sometimes bodies speak louder.", timer: 120, intensity: 2, section: 2 },
          { id: 112, category: "Hug & Kisses", title: "Shoulder Fabric Kiss", description: "Kiss their shoulder through the fabric while hugging. Feel the warmth of their skin beneath the cloth. Anticipate what's underneath.", timer: 120, intensity: 2, section: 2 },
          { id: 113, category: "Hug & Kisses", title: "Slow Waist Kiss", description: "Give a slow, lingering kiss while hands rest on their waist. This is where power and tenderness meet. Hold them here.", timer: 120, intensity: 2, section: 2 },
          { id: 114, category: "Hug & Kisses", title: "Side-to-Side Rock", description: "Hug them and gently rock side to side. This rhythmic movement is soothing. This is togetherness expressed through motion.", timer: 180, intensity: 2, section: 2 },
          { id: 115, category: "Hug & Kisses", title: "Hand Kiss Pull Embrace", description: "Kiss their hands, then pull them into a full embrace. Start small. Build to big. This crescendo of affection is powerful.", timer: 120, intensity: 2, section: 2 },
